{
  "name": "wonder-roulette",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "lint": "biome check --fix src/ scripts/ tests/ server/",
    "test": "vitest run",
    "simulate": "tsx scripts/simulate.ts",
    "server:dev": "wrangler dev --config server/wrangler.jsonc",
    "server:deploy": "wrangler deploy --config server/wrangler.jsonc --var ALLOWED_ORIGINS:https://kudongku99.github.io"
  },
  "dependencies": {
    "@fontsource/black-han-sans": "^5.3.0",
    "box2d-wasm": "7.0.0",
    "pretendard": "^1.3.9",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@cloudflare/workers-types": "5.20261113.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "sass": "^1.108.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
